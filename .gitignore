# Application
web/app/plugins/*
!web/app/plugins/.gitkeep
# Ignore Composer-installed mu-plugin directories; single-file mu-plugins are tracked intentionally
web/app/mu-plugins/*/
web/app/themes/twentytwentyfive/
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*
# WordFence's runtime WAF state: live rules, attack data, and an 8.6MB GeoIP database,
# all rewritten by the plugin on every request. Per-environment by nature, and the
# firewall recreates the directory on boot if it is missing.
web/app/wflogs/

# WordPress
web/wp
web/.htaccess

# Logs
*.log

# Dotenv
.env
.env.*
!.env.example
/env

# One-time production import artifacts (never commit)
/uploads.zip
/*.sql

# Release artifacts built by scripts/release.sh (DB dump + uploads zip). Ignored per-child
# rather than wholesale, so the exports directory below can be carved out of it — git does not
# descend into an ignored directory, so `/releases/` would make the negation unreachable.
/releases/*

# Gravity Forms entry exports, tracked on purpose: they are the inputs to
# `wp acorn lead:import-gravity` and the only copy of the pre-migration lead history. Unlike
# their neighbours they are small (22MB of CSV packs to 1.6MB) and are not regenerable from
# anything in this repo. release.sh only ever probes for exact v-YYYYMMDD-vN directory names,
# so this sibling is never mistaken for a release.
!/releases/exports/

# Composer
/vendor
auth.json

# PHPUnit/Pest
/phpunit.xml
.phpunit.result.cache
.phpunit.cache

# WP-CLI
wp-cli.local.yml

# macOS
.DS_Store
**/.DS_Store
