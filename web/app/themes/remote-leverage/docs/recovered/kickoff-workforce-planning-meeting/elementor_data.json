        "id": "bf8bc9d",
        "elType": "widget",
        "settings": {
          "html": "<!-- ===== Remote Leverage \u2014 revenue router \u2192 Calendly (v5) ===== -->\r\n<div id=\"rl-router\">\r\n\r\n  <!-- STEP 1: the question -->\r\n  <form id=\"rl-form\" class=\"rl-card\">\r\n    <div class=\"rl-head\">\r\n      <img class=\"rl-logo\"\r\n           src=\"https://remoteleverage.com/wp-content/uploads/2026/06/rl-26-logo.svg\"\r\n           alt=\"Remote Leverage\">\r\n    </div>\r\n\r\n    <div class=\"rl-form-col\">\r\n      <fieldset class=\"rl-fieldset\">\r\n        <legend class=\"rl-legend\">Revenue <span class=\"rl-req\">*</span></legend>\r\n\r\n        <label class=\"rl-option\">\r\n          <input type=\"radio\" name=\"revenue\" value=\"small\" required>\r\n          <span>0 to 5k Per Month</span>\r\n        </label>\r\n\r\n        <label class=\"rl-option\">\r\n          <input type=\"radio\" name=\"revenue\" value=\"small\">\r\n          <span>5k to 10k Per Month</span>\r\n        </label>\r\n\r\n        <label class=\"rl-option\">\r\n          <input type=\"radio\" name=\"revenue\" value=\"mid\">\r\n          <span>10k to 50k Per Month</span>\r\n        </label>\r\n\r\n        <label class=\"rl-option\">\r\n          <input type=\"radio\" name=\"revenue\" value=\"enterprise\">\r\n          <span>50k to 100k Per Month</span>\r\n        </label>\r\n\r\n        <label class=\"rl-option\">\r\n          <input type=\"radio\" name=\"revenue\" value=\"enterprise\">\r\n          <span>100k+ Per Month</span>\r\n        </label>\r\n\r\n        <label class=\"rl-option\">\r\n          <input type=\"radio\" name=\"revenue\" value=\"small\">\r\n          <span>Blank</span>\r\n        </label>\r\n      </fieldset>\r\n\r\n      <p id=\"rl-error\" class=\"rl-error\" hidden>Pick a revenue range to see available times.</p>\r\n\r\n      <button type=\"submit\" class=\"rl-submit\">See available times</button>\r\n    </div>\r\n  </form>\r\n\r\n  <!-- STEP 2: the booking calendar -->\r\n  <div id=\"rl-booking\" class=\"rl-card\" hidden>\r\n    <div class=\"rl-booking-head\">\r\n      <button type=\"button\" id=\"rl-back\" class=\"rl-back\">Change revenue range</button>\r\n      <a id=\"rl-newtab\" class=\"rl-newtab\" href=\"#\" target=\"_blank\" rel=\"noopener\">Open in a new tab</a>\r\n    </div>\r\n    <div id=\"rl-frame-wrap\" class=\"rl-frame-wrap\"></div>\r\n  </div>\r\n\r\n</div>\r\n\r\n<style>\r\n  /* Every selector is prefixed with #rl-router so theme styles can't win */\r\n  #rl-router {\r\n    --rl-purple: #6b21b8;\r\n    --rl-ink: #1c1233;\r\n    --rl-line: #d9d4e4;\r\n    --rl-blue: #2f80ed;\r\n    max-width: 1240px;          /* wide enough for Calendly's 2-column layout */\r\n    margin: 0 auto;\r\n    padding: 24px 16px 48px;\r\n    box-sizing: border-box;\r\n  }\r\n  #rl-router *, #rl-router *::before, #rl-router *::after { box-sizing: border-box; }\r\n\r\n  #rl-router .rl-card {\r\n    background: #fff;\r\n    border-radius: 14px;\r\n    box-shadow: 0 10px 40px rgba(20, 5, 50, .18);\r\n  }\r\n\r\n  #rl-router #rl-form {\r\n    max-width: 1060px;\r\n    margin: 0 auto;\r\n    padding: 40px 32px 48px;\r\n    text-align: center;\r\n  }\r\n\r\n  /* The booking card runs full width with tight padding, so the\r\n     iframe clears Calendly's ~1000px two-column threshold */\r\n  #rl-router #rl-booking {\r\n    padding: 22px 20px 26px;\r\n  }\r\n\r\n  /* Logo sits left; the rule spans the card, so it lives on the wrapper\r\n     rather than on the image, which could only ever be as wide as itself. */\r\n  #rl-router .rl-head {\r\n    padding-bottom: 24px;\r\n    margin-bottom: 32px;\r\n    border-bottom: 1px solid var(--rl-line);\r\n    text-align: center;\r\n  }\r\n  #rl-router .rl-logo {\r\n    display: inline-block;\r\n    width: 200px;\r\n    max-width: 60%;\r\n    height: auto;\r\n  }\r\n\r\n  /* Centred column. Options stay left-aligned inside it \u2014 centring a radio\r\n     list breaks the vertical line the eye follows down the labels. */\r\n  #rl-router .rl-form-col {\r\n    max-width: 320px;\r\n    margin: 0 auto;\r\n    text-align: left;\r\n  }\r\n\r\n  #rl-router .rl-fieldset { border: 0; margin: 0; padding: 0; }\r\n\r\n  #rl-router .rl-legend {\r\n    font-weight: 700;\r\n    font-size: 15px;\r\n    color: var(--rl-ink);\r\n    padding: 0;\r\n    margin-bottom: 10px;\r\n  }\r\n  #rl-router .rl-req { color: #c0392b; }\r\n\r\n  #rl-router .rl-option {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    padding: 5px 0;\r\n    margin: 0;\r\n    font-size: 15px;\r\n    color: var(--rl-ink);\r\n    line-height: 1.35;\r\n    cursor: pointer;\r\n  }\r\n  #rl-router .rl-option input {\r\n    width: 16px;\r\n    height: 16px;\r\n    accent-color: var(--rl-purple);\r\n    margin: 0;\r\n    flex: none;\r\n    cursor: pointer;\r\n  }\r\n  #rl-router .rl-option:hover span { color: var(--rl-purple); }\r\n\r\n  #rl-router .rl-error {\r\n    margin: 14px 0 0;\r\n    font-size: 14px;\r\n    color: #c0392b;\r\n  }\r\n\r\n  #rl-router .rl-submit {\r\n    display: block;\r\n    width: auto;\r\n    margin: 28px auto 0;\r\n    background: var(--rl-blue);\r\n    color: #fff;\r\n    border: 0;\r\n    border-radius: 999px;\r\n    padding: 13px 34px;\r\n    font-family: inherit;\r\n    font-size: 15px;\r\n    font-weight: 700;\r\n    line-height: 1.2;\r\n    text-transform: none;\r\n    letter-spacing: normal;\r\n    box-shadow: none;\r\n    cursor: pointer;\r\n  }\r\n  #rl-router .rl-submit:hover { background: #1f6fdc; color: #fff; }\r\n\r\n  #rl-router .rl-booking-head {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 8px 20px;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    margin-bottom: 14px;\r\n  }\r\n\r\n  #rl-router .rl-back,\r\n  #rl-router .rl-newtab {\r\n    display: inline-block;\r\n    width: auto;\r\n    background: none;\r\n    border: 0;\r\n    border-radius: 0;\r\n    margin: 0;\r\n    padding: 0;\r\n    font-family: inherit;\r\n    font-size: 14px;\r\n    font-weight: 600;\r\n    line-height: 1.2;\r\n    text-transform: none;\r\n    letter-spacing: normal;\r\n    text-decoration: underline;\r\n    color: var(--rl-purple);\r\n    box-shadow: none;\r\n    cursor: pointer;\r\n  }\r\n  #rl-router .rl-back:hover,\r\n  #rl-router .rl-newtab:hover { background: none; color: #4c1585; }\r\n\r\n  /* --- iframe sizing -----------------------------------------\r\n     Two-column layout above ~1000px is short and wide.\r\n     Below that Calendly stacks, so the frame needs to be taller. */\r\n  #rl-router .rl-frame-wrap { width: 100%; }\r\n  #rl-router .rl-frame-wrap iframe {\r\n    display: block;\r\n    width: 100%;\r\n    height: 700px;\r\n    border: 0;\r\n  }\r\n\r\n  @media (max-width: 1100px) {\r\n    #rl-router .rl-frame-wrap iframe { height: 1200px; }\r\n  }\r\n\r\n  @media (max-width: 700px) {\r\n    #rl-router #rl-form { padding: 28px 20px 34px; }\r\n    #rl-router #rl-booking { padding: 18px 12px 20px; }\r\n    #rl-router .rl-logo { width: 160px; }\r\n    #rl-router .rl-frame-wrap iframe { height: 1450px; }\r\n  }\r\n\r\n  #rl-router .rl-submit:focus-visible,\r\n  #rl-router .rl-back:focus-visible,\r\n  #rl-router .rl-newtab:focus-visible,\r\n  #rl-router .rl-option input:focus-visible {\r\n    outline: 3px solid var(--rl-purple);\r\n    outline-offset: 2px;\r\n  }\r\n</style>\r\n\r\n<script>\r\n(function () {\r\n  // Revenue tier -> Calendly event link\r\n  var LINKS = {\r\n    small:      'https://calendly.com/d/d2jq-z6m-5yt/kickoff-workforce-planning-meeting-t0',\r\n    mid:        'https://calendly.com/d/dvxh-c8m-p4k/kickoff-workforce-planning-meeting-t10',\r\n    enterprise: 'https://calendly.com/d/d2jp-krr-bng/kickoff-workforce-planning-meeting-t50'\r\n  };\r\n\r\n  var form    = document.getElementById('rl-form');\r\n  var booking = document.getElementById('rl-booking');\r\n  var wrap    = document.getElementById('rl-frame-wrap');\r\n  var errorEl = document.getElementById('rl-error');\r\n  var backBtn = document.getElementById('rl-back');\r\n  var newTab  = document.getElementById('rl-newtab');\r\n\r\n  function embedUrl(base) {\r\n    return base\r\n      + '?embed_domain=' + encodeURIComponent(window.location.hostname)\r\n      + '&embed_type=Inline'\r\n      + '&hide_gdpr_banner=1';\r\n  }\r\n\r\n  form.addEventListener('submit', function (e) {\r\n    e.preventDefault();\r\n\r\n    var picked = form.querySelector('input[name=\"revenue\"]:checked');\r\n    if (!picked) { errorEl.hidden = false; return; }\r\n    errorEl.hidden = true;\r\n\r\n    var base = LINKS[picked.value];\r\n\r\n    var frame = document.createElement('iframe');\r\n    frame.src = embedUrl(base);\r\n    frame.title = 'Book a workforce planning call';\r\n    frame.setAttribute('frameborder', '0');\r\n    frame.allow = 'camera; microphone; fullscreen; payment';\r\n\r\n    wrap.innerHTML = '';\r\n    wrap.appendChild(frame);\r\n\r\n    newTab.href = base;\r\n\r\n    form.hidden = true;\r\n    booking.hidden = false;\r\n    booking.scrollIntoView({ behavior: 'smooth', block: 'start' });\r\n  });\r\n\r\n  backBtn.addEventListener('click', function () {\r\n    wrap.innerHTML = '';\r\n    booking.hidden = true;\r\n    form.hidden = false;\r\n    form.scrollIntoView({ behavior: 'smooth', block: 'start' });\r\n  });\r\n})();\r\n</script>"
        },
        "elements": [],
        "widgetType": "html"
      }
    ],
    "isInner": false
  }
