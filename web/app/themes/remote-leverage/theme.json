          "color": "#F4F6FC",
          "name": "Background Light"
        },
        {
          "slug": "bg-map",
          "color": "#E4ECFC",
          "name": "Background Map Blue"
        },
        {
          "slug": "black",
          "color": "#000000",
          "name": "Absolute Black"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        }
      ]
    },
    "spacing": {
