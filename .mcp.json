{
  "mcpServers": {
    "rl-staging": {
      "command": "npx",
      "args": ["-y", "@automattic/mcp-wordpress-remote@latest"],
      "env": {
        "WP_API_URL": "${STAGING_MCP_URL:-https://staging.remoteleverage.com}/wp-json/mcp/mcp-adapter-default-server/",
        "WP_API_USERNAME": "${STAGING_MCP_USER:-ai-content-agent}",
        "WP_API_PASSWORD": "${STAGING_MCP_APP_PASSWORD}"
      }
    },
    "rl-production": {
      "command": "npx",
      "args": ["-y", "@automattic/mcp-wordpress-remote@latest"],
      "env": {
        "WP_API_URL": "${PRODUCTION_MCP_URL:-https://remoteleverage.com}/wp-json/mcp/mcp-adapter-default-server/",
        "WP_API_USERNAME": "${PRODUCTION_MCP_USER:-ai-content-agent}",
        "WP_API_PASSWORD": "${PRODUCTION_MCP_APP_PASSWORD}"
      }
    }
  }
}
