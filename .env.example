# Remote Leverage v2 — environment template
#
# Generated from web/app/themes/remote-leverage/docs/configuration.md, which is itself
# derived from a grep over every env() and Config::define() call. A key that is not here
# is not configuration.
#
# Two conventions in this file:
#   KEY=            the code has no default — leave blank only if you accept the
#                   degradation noted above it.
#   # KEY=value     the code has a working default. env() treats `KEY=` as an empty
#                   string, which OVERRIDES the default instead of falling back to it,
#                   so these stay commented. Uncomment only to override.
#
# Precedence: anything with an admin screen (Calendly tokens, lead settings, referral
# settings, webhook URLs) reads the admin option first and the environment variable
# second. Changing .env will not override a value an admin has set.


# ─────────────────────────────────────────────────────────────────────────────
# WordPress core (Bedrock, config/)
# ─────────────────────────────────────────────────────────────────────────────

DB_NAME='database_name'
DB_USER='database_user'
DB_PASSWORD='database_password'

# Optionally, you can use a data source name (DSN)
# When using a DSN, you can remove the DB_NAME, DB_USER, DB_PASSWORD, and DB_HOST variables
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

# Optional database variables
# DB_HOST='localhost'
# DB_HOST='127.0.0.1' # Use if you encounter mysqli 2002 / socket connection issues
# DB_PREFIX='wp_'
# DB_SSL=true         # Enables the MySQL SSL client flag

# Load-bearing: gates the sync feature, redirect_canonical removal and debug settings.
WP_ENV='development'
WP_HOME='http://example.com'
WP_SITEURL="${WP_HOME}/wp"

# Optional core toggles. Each has a default; blank would override it.
# WP_ENVIRONMENT_TYPE='development'   # defaults to WP_ENV
# WP_DEVELOPMENT_MODE='theme'
# WP_DEBUG_LOG='/path/to/debug.log'
# DISABLE_WP_CRON=true                # default false
# WP_POST_REVISIONS=5                 # default true (unlimited)

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# Laravel application key, base64: prefixed. Blank -> Acorn cannot encrypt or sign.
APP_KEY='generateme'

# ACF PRO license (maps to ACF_PRO_LICENSE). Blank -> ACF PRO will not install or update,
# and every ACF Composer block stops registering.
ACF_PRO_KEY='generateme'

# Redis object cache. Enabled only when WP_REDIS_HOST is set; blank disables it and the
# site falls back to the non-persistent object cache.
# WP_REDIS_HOST='127.0.0.1'
# WP_REDIS_PORT='6379'
# WP_REDIS_PASSWORD=''
# WP_REDIS_SCHEME='tcp'
# WP_REDIS_CLIENT='phpredis'
# WP_REDIS_PREFIX='local:'
# WP_REDIS_DATABASE='0'

# Acorn's cache store — a different cache from the WP object cache above, and worth being clear
# about which is which. WP_REDIS_* configures the Redis Object Cache drop-in, which backs
# wp_cache_get(). CACHE_STORE configures Laravel's Cache facade, which is what the theme's own
# code calls: the admin dashboard KPI blocks, the domain overview and the marketing snapshot.
#
# Unset, Acorn defaults to `file`. On ECS that means every task keeps a private copy on its own
# container filesystem and a rolling deploy discards all of them, so the admin dashboard
# recomputes per task. Set CACHE_STORE=redis in staging and production.
#
# Laravel reads REDIS_HOST/REDIS_PORT without the WP_ prefix, so both variables are needed when
# Redis backs both caches. They can point at one server: the object cache sits on
# WP_REDIS_DATABASE (0) and Laravel's on REDIS_CACHE_DB (1), so the two never collide.
# CACHE_STORE='redis'
# REDIS_HOST='127.0.0.1'
# REDIS_PORT='6379'
# REDIS_PASSWORD=''
# REDIS_CACHE_DB='1'


# ─────────────────────────────────────────────────────────────────────────────
# Scheduling — Calendly (config/services.php)
# ─────────────────────────────────────────────────────────────────────────────

# Seeds CalendlyTokenPool (option rl_calendly_token_pool). Blank -> no availability is
# fetched and the booking wizard cannot show or book a slot.
CALENDLY_API_KEY=

# Rate-limit failover pool. CALENDLY_API_KEY is tried first; these are used only on HTTP 429.
CALENDLY_API_KEY_2=
CALENDLY_API_KEY_3=
CALENDLY_API_KEY_4=

# CalendlyClient's owning user. Blank -> event-type and availability lookups fail.
CALENDLY_USER_URI=

# Event-type routing. Each has a hardcoded production default in config/services.php and
# seeds CalendlyEventTypeRoleResolver (option rl_calendly_event_type_roles); once set in
# wp-admin the option wins. Blank would override the default with an empty URI.
# CALENDLY_DEFAULT_EVENT_TYPE='https://api.calendly.com/event_types/…'
# CALENDLY_T10_EVENT_TYPE='https://api.calendly.com/event_types/…'   # MRR >= $10k
# CALENDLY_T0_EVENT_TYPE='https://api.calendly.com/event_types/…'    # MRR <  $10k

# Instant live call. Blank -> the instant-call route has no event type to book against.
CALENDLY_LIVE_CALL_EVENT_TYPE=

# Webhook signature verification for /api/webhooks/calendly (WebhookSignature). The endpoint
# fails CLOSED: blank -> every delivery is refused with 503 and no booking event is acted on.
# Must be set in every environment. Calendly retries, so a short gap is recoverable.
CALENDLY_WEBHOOK_SIGNING_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Scheduling — Google Calendar (GoogleCalendarClient)
# ─────────────────────────────────────────────────────────────────────────────

# Blank -> no Google Calendar event is created for a booking; Calendly still works.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Defaults. Blank would override them with an empty string.
# GOOGLE_CALENDAR_ID='primary'
# LIVE_CALL_MEET_URL=                  # LiveCallAvailabilityRouter, default: its DEFAULT_MEET_URL
# STRATEGY_CONSULTANT_EMAIL=           # BookMeetingAction attendee, default: team@remoteleverage.com


# ─────────────────────────────────────────────────────────────────────────────
# Lead
# ─────────────────────────────────────────────────────────────────────────────

# HubSpotGateway, as the fallback behind the admin-configured token. Blank -> HubSpot
# sync silently no-ops: the lead is captured and the dispatch is logged, but no CRM
# contact is ever created.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# ZeroBounce mailbox verification for the lead forms. The wp-admin value (Leads -> Settings)
# wins; this is the fallback. Blank -> the domain/address lists still apply, ZeroBounce is
# skipped. Verification always fails OPEN: a verifier outage must not reject real buyers.
ZEROBOUNCE_API_KEY=

# Slack, through the site's own app ("Remote Leverage Website", A0C2296E7U3). With a token AND
# a channel set, chat.postMessage is used and alerts can thread; otherwise SLACK_WEBHOOK_URL is
# the fallback, which cannot thread. Both blank -> nothing is sent. Token and channel also have
# wp-admin fallbacks (Leads -> Settings) that reach staging by environment sync.
SLACK_BOT_TOKEN=
# SLACK_CHANNEL='C086BBKUXL5'        # default; #new-appts, the channel the legacy feed posted to
# SLACK_NOTIFY_ON_BOOKING=false      # default true — set false to alert on submission only
SLACK_WEBHOOK_URL=

# Verifies inbound Slack interactions, and doubles as the on switch for the action buttons on a
# lead alert (Claim / Mark contacted / Block). Blank here falls back to the wp-admin value
# (Leads -> Settings), which is how it reaches staging: the Lead settings blob is in the
# environment-sync whitelist, so it can be set locally and pushed without a task-definition
# change. Unset in BOTH -> SlackInteractionController refuses every request AND the buttons are
# not rendered, because Slack would otherwise show "not configured to handle interactive
# responses" beside them. Set the app's Interactivity request URL to
# https://<host>/api/webhooks/slack/interactions at the same time. See docs/slack-app.md.
SLACK_SIGNING_SECRET=

# Where HandleLeadEventsForWebhook POSTs the full lead object — on the step-one partial capture,
# on the completed (Final) submission, and again when the booking confirms. Consumers tell the
# first two apart by `lead.submission_type`, not by the event name.
#
# Commented out on purpose: config/services.php already defaults this to the n8n endpoint
# (.../webhook/gravityforms-leads), so an environment that says nothing here posts to n8n. Set it
# to point somewhere else, or to an explicit empty value (LEAD_WEBHOOK_URL=) to switch the feed
# off — an empty value is NOT the same as absent, and overrides the default.
# LEAD_WEBHOOK_URL=


# ─────────────────────────────────────────────────────────────────────────────
# Tracking
# ─────────────────────────────────────────────────────────────────────────────

# PostHogClient and the front-end snippet. Blank -> no product analytics are captured.
POSTHOG_API_KEY=
# POSTHOG_HOST='https://us.i.posthog.com'   # default; blank would override it

# CustomerIOClient (Track API v1, server side). Blank -> leads are never identified into
# Customer.io, so lifecycle email does not fire.
CUSTOMERIO_SITE_ID=
CUSTOMERIO_API_KEY=

# Customer.io CDP (Data Pipelines) source write key, used by the browser `cioanalytics`
# snippet TrackingHooks injects. This is a DIFFERENT credential from CUSTOMERIO_SITE_ID
# above — a site id here would 404 on the CDP asset URL and silently queue every event.
# Blank -> no snippet is emitted and every client call site no-ops.
# Source: the `analytics.load("…")` argument in the page source of remoteleverage.com and
# rl-testing.test — identical on both. It is a publishable browser key, not a secret.
CUSTOMERIO_CDP_WRITE_KEY=

# LinkedIn Insight and the Meta Pixel *ids* are configured in config/pixels.php, not here.
# (They were in the GTM container until 2026-09-18; that container is retired.)

# Meta Conversions API — the server-side `Lead`. This is the credential, the pixel ids live in
# config/pixels.php and are shared with the browser pixel.
#
# Blank -> no server-side event is sent and every call site no-ops. That is not a safe steady
# state: Meta's conversion signal is server-side only on this site, so a blank token means Ads
# Manager reports 0 conversions no matter how many leads come in. That is exactly what happened
# between the 2026-09-17 cutover and 2026-09-18.
#
# Source: the legacy GoDaddy install's `handl_fb_access_token` option (199 chars, `EAAT…`).
# Retrieve it with, on that box:
#   wp --skip-plugins --skip-themes option get handl_fb_access_token
#
# Caveat worth knowing before relying on it: that token was minted through HandL's own Facebook
# app via api.handldigital.com and is tied to their licence key, so it dies if the licence
# lapses or they rotate it. A System User token issued from your own Business Manager is the
# durable replacement — this one is the fast path, not the final answer.
META_CAPI_ACCESS_TOKEN=

# Marketing cost alert. See web/app/themes/remote-leverage/docs/marketing-cost-alerts.md.
# MARKETING_COST_ALERT_ENABLED=
# MARKETING_COST_ALERT_CHANNEL=
# MARKETING_COST_ALERT_TIMEZONE=
# MARKETING_COST_ALERT_FROM_HOUR=
# MARKETING_COST_ALERT_TO_HOUR=
# MARKETING_TARGET_CPB=
# MARKETING_TARGET_CPQB=

# Ad platform read credentials. META_ADS_* is live: set the token and account id and the alert
# reports Meta spend, CPB, CPQB and account status. Google and Microsoft are later phases and are
# skipped while unset. All of these can also be set in wp-admin under Leads > Settings, which is how
# they reach an environment whose task definition does not expose them yet; the variable always wins.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# META_ADS_ACCESS_TOKEN=          # defaults to META_CAPI_ACCESS_TOKEN above; needs ads_read
# META_ADS_ACCOUNT_ID=
# MICROSOFT_ADS_DEVELOPER_TOKEN=
# MICROSOFT_ADS_CLIENT_ID=
# MICROSOFT_ADS_CLIENT_SECRET=
# MICROSOFT_ADS_REFRESH_TOKEN=
# MICROSOFT_ADS_CUSTOMER_ID=
# MICROSOFT_ADS_ACCOUNT_ID=

# Defaults to v11.0, matching what the legacy integration used and what is proven to work with
# this token. Bump deliberately.
# META_CAPI_API_VERSION='v11.0'

# Set to a Test Event code while validating in Events Manager -> Test Events; blank otherwise.
# META_CAPI_TEST_EVENT_CODE=

# META_CAPI_ENABLED=true


# ─────────────────────────────────────────────────────────────────────────────
# Payments & Referral
# ─────────────────────────────────────────────────────────────────────────────

# Stripe Connect (referrer payouts) and live inbound card charges. Blank -> payouts and
# the embedded checkout are both unavailable.
STRIPE_KEY=
STRIPE_SECRET=

# Test key pair for the embedded checkout, used when STRIPE_TEST_MODE is on.
STRIPE_TEST_KEY=
STRIPE_TEST_SECRET=
# STRIPE_TEST_MODE=true            # default false — live keys drive inbound charges

# Connect onboarding. Blank -> a referrer cannot connect a payout account.
STRIPE_CONNECT_CLIENT_ID=

# StripeWebhookController signature verification (WebhookSignature). Fails CLOSED like the
# Calendly one: blank -> every delivery is refused with 503, so Connect payout events are
# never processed. Must be set in every environment.
STRIPE_WEBHOOK_SECRET=

# Optional Stripe extras. Blank is harmless: no forwarding, and payment lands on this site's
# own /referral-program-thank-you-page-deposit/ when a block sets no thank-you URL.
#
# Leave STRIPE_DEFAULT_THANKYOU_URL blank unless a payment must land on a DIFFERENT host.
# PaymentGatewayBlock resolves the path through home_url(), so it is already right in every
# environment; an absolute value set here is copied verbatim into staging by
# scripts/seed-staging-secrets.sh, which is how a local `.test` host reached a live checkout.
STRIPE_WEBHOOK_FORWARD_URL=
STRIPE_DEFAULT_THANKYOU_URL=

# DispatchReferralWebhook. Blank -> referral events are recorded but never posted out.
REFERRAL_WEBHOOK_URL=
# REFERRAL_DEFAULT_REWARD_AMOUNT=14.00   # default; blank would override it


# ─────────────────────────────────────────────────────────────────────────────
# Environment sync
# ─────────────────────────────────────────────────────────────────────────────
#
# Read locally so the sync screen can call out to a remote; never baked into a container
# and never seeded by scripts/seed-staging-secrets.sh. Mint the credential on the remote
# itself via Settings -> Environment Sync -> Generate sync credentials.
# STAGING_SYNC_URL='https://staging.example.com'
# STAGING_SYNC_USER='sync-service'
# STAGING_SYNC_APP_PASSWORD='xxxx xxxx xxxx xxxx xxxx xxxx'

# Present so gate 3 has a URL to refuse. Setting these does not make production syncable;
# three other gates still refuse.
# PRODUCTION_SYNC_URL='https://remoteleverage.com'
# PRODUCTION_SYNC_USER='sync-service'
# PRODUCTION_SYNC_APP_PASSWORD='xxxx xxxx xxxx xxxx xxxx xxxx'

# TEMPORARY, and now removable. Also sends the sync credential as a request body
# field, for a remote behind a CDN that strips the Authorization header. Paired
# with web/app/mu-plugins/rl-sync-body-auth.php.
#
# VERIFIED 2026-09-15: CloudFront now forwards Authorization on
# /wp-json/wp-abilities/*, so this flag no longer changes the outcome. Set it to
# false, confirm a push still runs, then delete both halves.
# (Mcp-Session-Id is a different header and is still stripped. Since 2026-09-16 that is
#  covered by web/app/mu-plugins/rl-mcp-session-bridge.php, so MCP works — but the
#  distribution is still wrong. See docs/known-issues.md item 20.)
# STAGING_SYNC_BODY_AUTH=true


# ─────────────────────────────────────────────────────────────────────────────
# Monitoring
# ─────────────────────────────────────────────────────────────────────────────

# sentry/sentry-laravel is installed and config/sentry.php is fully populated, but with no
# DSN nothing is reported from any environment. "Error monitoring reporting" is a
# production cutover gate — see docs/production-cutover.md.
SENTRY_LARAVEL_DSN=
# SENTRY_DSN=          # alias read only when SENTRY_LARAVEL_DSN is unset

# Optional. Every other SENTRY_* key in config/sentry.php is the package's own default set
# (breadcrumb and tracing toggles) and needs no project value.
# SENTRY_ENVIRONMENT='staging'

# APP_VERSION feeds config/sentry.php's `release` (not a SENTRY_*-prefixed name because the
# same value also feeds window.APP_VERSION for the browser SDK — see app.blade.php). Left
# unset here: the Docker build writes it straight into /var/www/html/.env (Dockerfile ARG
# RELEASE_VERSION) — the v-YYYYMMDD-vN release tag in production, the commit SHA in staging,
# which isn't tag-triggered — and Bedrock's own Dotenv loader in config/application.php picks
# it up from there. A real environment variable (task definition, docker-compose) always wins
# over .env, so this is purely a fallback. Set this only to override the baked value, e.g. for
# a local container.
# APP_VERSION=''
# SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_PROFILES_SAMPLE_RATE=0.2


# ─────────────────────────────────────────────────────────────────────────────
# AI content agent (config/ai-wordpress.php)
# ─────────────────────────────────────────────────────────────────────────────
#
# All defaulted, and the capability flags default to the safe answer. Blank would override
# the default, so these stay commented. See docs/ai-mcp-and-sync.md.
# AI_AGENT_LOGIN='ai-content-agent'
# AI_AGENT_EMAIL='ai-content-agent@remoteleverage.com'
# AI_AGENT_ROLE='editor'
# AI_AGENT_CAN_PUBLISH=false            # publish_pages — clone-page may publish directly
# AI_AGENT_CAN_EDIT_PUBLISHED=false     # edit_published_pages — may change live pages
# AI_AGENT_CAN_READ_LEADS=false         # rl_read_business_data — may read enquiry data
# AI_AGENT_PROVISION_ON_DEPLOY=true     # set false to skip reconciliation entirely


# ─────────────────────────────────────────────────────────────────────────────
# AI providers (config/ai.php, ships with roots/acorn-ai)
# ─────────────────────────────────────────────────────────────────────────────
#
# config/ai.php enumerates every provider the package supports (OPENAI_API_KEY,
# ANTHROPIC_API_KEY, AWS_BEDROCK_*, AZURE_OPENAI_*, COHERE_API_KEY, GROQ_API_KEY,
# MISTRAL_API_KEY, OLLAMA_*, OPENROUTER_API_KEY, DEEPSEEK_API_KEY, XAI_API_KEY,
# VOYAGEAI_API_KEY, JINA_API_KEY, ELEVENLABS_API_KEY and more). These are vendor defaults,
# not project configuration — set only the provider actually used. The config's declared
# defaults are `openai` generally and `gemini` for images.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Mail
# ─────────────────────────────────────────────────────────────────────────────
#
# Nothing in the theme reads these: WordPress mail is not routed through Laravel's mailer
# here. They matter only once an SMTP plugin or a wp_mail filter is added.
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=
